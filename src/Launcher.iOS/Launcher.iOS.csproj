<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-ios</TargetFramework>
    <OutputType>Exe</OutputType>
    <RuntimeIdentifier>ios-arm64</RuntimeIdentifier>
    <SupportedOSPlatformVersion>16.0</SupportedOSPlatformVersion>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <ApplicationId>org.sts2mobile.ioslauncher</ApplicationId>
    <PublishAot>false</PublishAot>
    <UseInterpreter>true</UseInterpreter>
    <TrimMode>full</TrimMode>
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="../Launcher.Steam/Launcher.Steam.csproj"/></ItemGroup>
  <ItemGroup>
    <TrimmerRootAssembly Include="Launcher.Core"/>
    <TrimmerRootAssembly Include="Launcher.Steam"/>
    <TrimmerRootAssembly Include="SteamKit2"/>
    <TrimmerRootAssembly Include="protobuf-net"/>
    <TrimmerRootAssembly Include="protobuf-net.Core"/>
  </ItemGroup>
</Project>
